# Last Bench environment template
#
# Never commit real credentials. Server secrets belong in Render. Public Expo
# values belong in Netlify because they are baked into the browser bundle by
# `pnpm build:web:production`.

# ---------------------------------------------------------------------------
# Render API (server-side)
# ---------------------------------------------------------------------------

NODE_ENV=production

# Render assigns PORT automatically. Use 3000 only for local development.
PORT=3000

# Supabase Postgres transaction-pooler URL (TLS required).
DATABASE_URL=postgres://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase Auth + Storage. The publishable key is intentionally safe for client
# use. Never put an sb_secret_* or service-role credential in a public Expo env.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Current canonical browser origin.
FRONTEND_URL=https://lastbenchbd.com

# Comma-separated browser origins. Keep production narrow.
CORS_ALLOWED_ORIGINS=https://lastbenchbd.com

# Render normally forwards through one trusted proxy hop.
TRUST_PROXY_HOPS=1

# Optional: Supabase Auth user UUID that should receive platform-admin role.
ADMIN_AUTH_USER_ID=

# Direct OpenAI Responses API. Keep the API key server-side in Render only.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
AI_GUIDANCE_MODEL=gpt-5.6-terra

# Optional. Off by default. When enabled, only redacted error summaries are
# sent for diagnosis and every generated fix remains advisory until approved.
AUTO_DIAGNOSE_ERRORS=false

# ---------------------------------------------------------------------------
# Netlify web build (public values baked into dist/app)
# ---------------------------------------------------------------------------

EXPO_PUBLIC_API_BASE_URL=https://api.lastbenchbd.com
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
